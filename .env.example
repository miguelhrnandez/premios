# Base de datos Supabase (Postgres). En el dashboard de Supabase:
# Project Settings > Database > Connection string
# DATABASE_URL = conexión "Transaction pooler" (puerto 6543, agregar ?pgbouncer=true)
# DIRECT_URL   = conexión "Direct connection" (puerto 5432), usada solo para migraciones
DATABASE_URL="postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

AUTH_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
